# Base URL for the Nadir Wallet API. Optional on a simulator (defaults to
# http://localhost:8787). On a physical device, set it to the dev machine's
# LAN address so the device can reach the API.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Apple developer team used for device builds (`expo run:ios --device`).
# Read by app.config.js; leave empty to pick a team in Xcode instead.
APPLE_TEAM_ID=
