{
  "name": "NadirWallet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:mobile": "turbo run dev --filter=@nadir-wallet/mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@nadir-wallet/config": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
